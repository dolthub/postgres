# The cases' cleanup callbacks.

root_alloc::release

# The cases' stand-in for `pg`'s `entries.list` (design item 17): each entry's name, C return type, C parameters,
# what a panic in it becomes (error or panic), whether it runs with catalog access, and the reason.

cases_release	void		panic	nocatalog	a release entry, which never allocates
cases_version	Datum	FunctionCallInfo fcinfo	error	catalog	an ordinary entry, which may allocate
