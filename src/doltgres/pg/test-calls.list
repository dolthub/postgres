# The test-only wrappers, in calls.list's form, generated only with the injection_points feature, which cargo.pl turns
# on exactly when Postgres is built with injection points (design item 17).

escalate	void		escalates	nocatalog	it raises on purpose, and its wrapper turns what it raises into a PANIC	elog(ERROR, "an error inside an escalating wrapper")	test/t/003_shmem.pl: an error inside an escalating wrapper becomes a PANIC
injection_point_cached	void	const char *name	raises	nocatalog	InjectionPointCached runs a callback loaded before, so it allocates nothing and can run in a critical section; it reads no catalog	INJECTION_POINT_CACHED(name, NULL)	test/t/006_wal.pl: a checkpoint waits for the delay guard
injection_point_load	void	const char *name	raises	nocatalog	InjectionPointLoad loads an attached point's callback into the backend's cache, which allocates, before a checkpoint window's critical section; it reads no catalog	INJECTION_POINT_LOAD(name)	test/t/006_wal.pl: a checkpoint waits for the delay guard
clear_delay_flag	void		noraise	nocatalog	clearing a flag of MyProc only writes it, as a Postgres call ending its own delay inside the fork's would	MyProc->delayChkptFlags &= ~DELAY_CHKPT_START	test/t/006_wal.pl: a delay whose flag was cleared inside it stops the server
bytea_datum	Datum	DgBytes bytes	raises	nocatalog	copying the bytes into a new bytea only allocates	bytea *copy = (bytea *) palloc(VARHDRSZ + bytes.len); SET_VARSIZE(copy, VARHDRSZ + bytes.len); memcpy(VARDATA(copy), bytes.data, bytes.len); *out = PointerGetDatum(copy)	test/t/008_compression.pl: the fork's zstd output is the recorded one
transaction_owner	void	bool on	noraise	nocatalog	switching the current resource owner only writes the variable, as a portal's start and end do	static ResourceOwner saved; if (on) { saved = CurrentResourceOwner; CurrentResourceOwner = CurTransactionResourceOwner; } else CurrentResourceOwner = saved	test/t/009_cache.pl: a cursor's pin survives a rollback to a savepoint, and a subtransaction's abort releases only its own pins
no_owner	void	bool on	noraise	nocatalog	clearing the current resource owner only writes the variable, as the end of a transaction does	static ResourceOwner saved; if (on) { saved = CurrentResourceOwner; CurrentResourceOwner = NULL; } else CurrentResourceOwner = saved	test/t/009_cache.pl: a pin with no resource owner is refused
report_at_log	void		noraise	nocatalog	a report at LOG returns, and the wrapper's hold of interrupts keeps it from taking a pending cancel, which is what the test shows	ereport(LOG, errmsg("a report inside a wrapper that does not raise"))	test/t/005_file.pl: a cancel pending when a call that doesn't raise reports ends the statement
fatal	void		raises	nocatalog	it only ends the backend, as a FATAL in any Postgres call does	ereport(FATAL, (errcode(ERRCODE_INTERNAL_ERROR), errmsg("the test ended its backend")))	test/t/007_shared.pl: a FATAL under a record's lock frees a condemned slot, and the new record's lock is taken
zeroing	void	const char *name	escalates	nocatalog	InjectionPointRun reads no catalog and runs only a test's callback; it runs in an exit callback, where nothing may raise, so anything raised becomes a PANIC	INJECTION_POINT(name, NULL)	test/t/012_slots.pl: an exit zeroes a process's words lowest index first
exit_callback	void		raises	nocatalog	before_shmem_exit raises only its FATAL when every slot of its list is taken; it reads no catalog	before_shmem_exit(doltgres_test_exit_callback, (Datum) 0)	test/t/016_exit_doors.pl: a backend registers as many exit callbacks as stock leaves it, and one more is out of slots
cancel_exit_callback	void		raises	nocatalog	cancel_before_shmem_exit raises only when the callback isn't the newest registered; it reads no catalog	cancel_before_shmem_exit(doltgres_test_exit_callback, (Datum) 0)	test/t/016_exit_doors.pl: a callback registered and cancelled around a backend's first use of shared records raises nothing
in_transaction	bool		noraise	nocatalog	IsTransactionState only reads the transaction's state	IsTransactionState()	test/t/016_exit_doors.pl: a work in a backend that exits inside a transaction finds the transaction ended
stop_point	void	const char *name	escalates	nocatalog	InjectionPointRun reads no catalog and runs only a test's callback; it runs inside a sequence of the delta's pages that can't fail, so anything raised becomes a PANIC	INJECTION_POINT(name, NULL)	test/t/017_pages.pl: a second free pass at a pass's pause frees nothing
arg_null	bool	FunctionCallInfo fcinfo, int n	noraise	nocatalog	PG_NARGS and PG_ARGISNULL only read the call's own fields	n < 0 || n >= PG_NARGS() || PG_ARGISNULL(n)	test/t/028_keys.pl: a NULL's key is its marker alone
arg_type	Oid	FunctionCallInfo fcinfo, int n	raises	catalog		get_fn_expr_argtype(fcinfo->flinfo, n)	test/t/028_keys.pl: a type with no default btree class is refused with Postgres' error
arg_byval	bool	FunctionCallInfo fcinfo, int n	raises	catalog		get_typbyval(get_fn_expr_argtype(fcinfo->flinfo, n))	test/t/028_keys.pl: a text read inline with a full header gives its key
arg_word	uint64	FunctionCallInfo fcinfo, int n	raises	catalog		if (n < 0 || n >= PG_NARGS() || PG_ARGISNULL(n) || !get_typbyval(get_fn_expr_argtype(fcinfo->flinfo, n))) elog(ERROR, "argument %d holds no value passed by value", n); *out = (uint64) PG_GETARG_DATUM(n)	test/t/028_keys.pl: a NULL's key is its marker alone
arg_bytes	DgBytes	FunctionCallInfo fcinfo, int n	raises	catalog	pg_detoast_datum_packed reads the TOAST relation of a value out of line; the copy it makes of a compressed or out-of-line value is allocated in the memory context the entry was called in, which no call the fork makes resets, so the bytes outlive the entry's capability	{ int16 len; bool byval; if (n < 0 || n >= PG_NARGS() || PG_ARGISNULL(n)) elog(ERROR, "argument %d holds no value", n); get_typlenbyval(get_fn_expr_argtype(fcinfo->flinfo, n), &len, &byval); if (byval || len == -2) elog(ERROR, "argument %d holds no stored bytes", n); if (len == -1) { struct varlena *value = pg_detoast_datum_packed((struct varlena *) DatumGetPointer(PG_GETARG_DATUM(n))); *out = (DgBytes) {VARDATA_ANY(value), VARSIZE_ANY_EXHDR(value)}; } else *out = (DgBytes) {DatumGetPointer(PG_GETARG_DATUM(n)), len}; }	test/t/028_keys.pl: a text read with a short header, compressed, and out of line gives its key
word_read	uint64	uint64 word, int kind	noraise	nocatalog	the DatumGet macros only cast, and a float's bits are read back through its GetDatum macro	kind == 0 ? (uint64) DatumGetBool((Datum) word) : kind == 1 ? (uint64) (unsigned char) DatumGetChar((Datum) word) : kind == 2 ? (uint64) (int64) DatumGetInt16((Datum) word) : kind == 3 ? (uint64) (int64) DatumGetInt32((Datum) word) : kind == 4 ? (uint64) DatumGetInt64((Datum) word) : kind == 5 ? (uint64) DatumGetObjectId((Datum) word) : kind == 6 ? (uint64) (uint32) DatumGetInt32(Float4GetDatum(DatumGetFloat4((Datum) word))) : (uint64) DatumGetInt64(Float8GetDatum(DatumGetFloat8((Datum) word)))	test/t/001_binding.pl: each word reader and writer gives what its macro gives
word_write	uint64	uint64 value, int kind	noraise	nocatalog	the GetDatum macros only cast	kind == 0 ? (uint64) BoolGetDatum(value != 0) : kind == 1 ? (uint64) CharGetDatum((char) value) : kind == 2 ? (uint64) Int16GetDatum((int16) value) : kind == 3 ? (uint64) Int32GetDatum((int32) value) : kind == 4 ? (uint64) Int64GetDatum((int64) value) : (uint64) ObjectIdGetDatum((Oid) value)	test/t/001_binding.pl: each word reader and writer gives what its macro gives
call_collation	Oid	FunctionCallInfo fcinfo	noraise	nocatalog	PG_GET_COLLATION only reads the call's own fields	PG_GET_COLLATION()	test/t/028_keys.pl: collated text orders as Postgres orders it
slot_tuple_natts	int	const TupleTableSlot *slot	noraise	nocatalog	it reads the header of a heap slot's own tuple, and answers -1 for a slot of any other kind	(TTS_IS_HEAPTUPLE(slot) || TTS_IS_BUFFERTUPLE(slot)) && ((const HeapTupleTableSlot *) slot)->tuple != NULL ? HeapTupleHeaderGetNatts(((const HeapTupleTableSlot *) slot)->tuple->t_data) : -1	test/t/029_slot.pl: a row stored before a column was added with a default reads back the default
slot_tuple_xmin	uint64	const TupleTableSlot *slot	noraise	nocatalog	it reads the header of a heap slot's own tuple, and answers 0 for a slot of any other kind	(TTS_IS_HEAPTUPLE(slot) || TTS_IS_BUFFERTUPLE(slot)) && ((const HeapTupleTableSlot *) slot)->tuple != NULL ? U64FromFullTransactionId(FullTransactionIdFromAllowableAt(ReadNextFullTransactionId(), HeapTupleHeaderGetRawXmin(((const HeapTupleTableSlot *) slot)->tuple->t_data))) : 0	test/t/029_slot.pl: a stored row's system columns are heap's own
slot_tuple_xmax	uint64	const TupleTableSlot *slot	raises	nocatalog	it reads the header of a heap slot's own tuple, and answers no value for a slot of any other kind; a multixact's xmax is refused	{ HeapTupleHeader h = (TTS_IS_HEAPTUPLE(slot) || TTS_IS_BUFFERTUPLE(slot)) && ((const HeapTupleTableSlot *) slot)->tuple != NULL ? ((const HeapTupleTableSlot *) slot)->tuple->t_data : NULL; *out = 0; if (h != NULL && (h->t_infomask & HEAP_XMAX_IS_MULTI)) elog(ERROR, "a test row's xmax is a multixact"); if (h != NULL && TransactionIdIsValid(HeapTupleHeaderGetRawXmax(h))) *out = U64FromFullTransactionId(FullTransactionIdFromAllowableAt(ReadNextFullTransactionId(), HeapTupleHeaderGetRawXmax(h))); }	test/t/029_slot.pl: a stored row's system columns are heap's own
slot_tuple_cmin	uint32	const TupleTableSlot *slot	noraise	nocatalog	it reads the header of a heap slot's own tuple, and answers no value for a slot of any other kind; combocid.c resolves a combo cid of the current transaction's row, allocating nothing	{ HeapTupleHeader h = (TTS_IS_HEAPTUPLE(slot) || TTS_IS_BUFFERTUPLE(slot)) && ((const HeapTupleTableSlot *) slot)->tuple != NULL ? ((const HeapTupleTableSlot *) slot)->tuple->t_data : NULL; result = h == NULL ? InvalidCommandId : TransactionIdIsCurrentTransactionId(HeapTupleHeaderGetRawXmin(h)) ? HeapTupleHeaderGetCmin(h) : HeapTupleHeaderGetRawCommandId(h); }	test/t/029_slot.pl: a stored row's system columns are heap's own
slot_tuple_cmax	uint32	const TupleTableSlot *slot	raises	nocatalog	it reads the header of a heap slot's own tuple, and answers no value for a slot of any other kind; it answers the raw command id of a change, a combo cid as heap keeps one, which the fork's version keeps as its raw command; a multixact's xmax is refused	{ HeapTupleHeader h = (TTS_IS_HEAPTUPLE(slot) || TTS_IS_BUFFERTUPLE(slot)) && ((const HeapTupleTableSlot *) slot)->tuple != NULL ? ((const HeapTupleTableSlot *) slot)->tuple->t_data : NULL; TransactionId xmax = h != NULL ? HeapTupleHeaderGetRawXmax(h) : InvalidTransactionId; *out = InvalidCommandId; if (h != NULL && (h->t_infomask & HEAP_XMAX_IS_MULTI)) elog(ERROR, "a test row's xmax is a multixact"); if (h != NULL && TransactionIdIsValid(xmax) && !HEAP_XMAX_IS_LOCKED_ONLY(h->t_infomask)) *out = HeapTupleHeaderGetRawCommandId(h); }	test/t/029_slot.pl: a stored row's system columns are heap's own
slot_value_toast	int	const TupleTableSlot *slot, int att	noraise	nocatalog	it reads the slot's own arrays and a varlena's header	att < 0 || att >= slot->tts_nvalid || slot->tts_isnull[att] || TupleDescCompactAttr(slot->tts_tupleDescriptor, att)->attlen != -1 ? -1 : VARATT_IS_EXTERNAL_ONDISK(DatumGetPointer(slot->tts_values[att])) ? 2 : VARATT_IS_COMPRESSED(DatumGetPointer(slot->tts_values[att])) ? 1 : 0	test/t/029_slot.pl: a row past the threshold moves the values heap moves out of line
granted_relation_locks	size_t		raises	nocatalog	the shared lock table's entries as lock.c's NLOCKENTS sizes them, and every backend's fast-path slots, read from Postgres' globals once the backend's init set FastPathLockGroupsPerBackend; mul_size and add_size raise only on an overflow; it reads no catalog	*out = add_size(mul_size(max_locks_per_xact, add_size(MaxBackends, max_prepared_xacts)), mul_size(MaxBackends, FastPathLockSlotsPerBackend()))	test/t/032_state.pl: the storage states' pool holds a state for each relation lock a backend's own globals count
rel_am	Oid	Relation rel	noraise	nocatalog	it reads the relcache entry's own copy of the relation's pg_class row	rel->rd_rel->relam	test/t/030_handler.pl: a heap twin and its TOAST table keep heap's routine and its index nbtree's, while a fork table and a table USING heap are the fork's
class_am	Oid	Oid relid	raises	catalog	SearchSysCache1 reads the relation's pg_class row through the syscache, refusing a missing row with relcache.c's words	{ HeapTuple t = SearchSysCache1(RELOID, ObjectIdGetDatum(relid)); if (!HeapTupleIsValid(t)) elog(ERROR, "cache lookup failed for relation %u", relid); *out = ((Form_pg_class) GETSTRUCT(t))->relam; ReleaseSysCache(t); }	test/t/030_handler.pl: a heap twin and its TOAST table keep heap's routine and its index nbtree's, while a fork table and a table USING heap are the fork's
am_twin	bool	Oid amid	raises	catalog	SearchSysCache1 reads the access method's pg_am row and its handler's pg_proc row through the syscache, refusing a missing row with amapi.c's and fmgr.c's words	{ HeapTuple am = SearchSysCache1(AMOID, ObjectIdGetDatum(amid)); Oid handler; HeapTuple proc; bool isnull; Datum bin; if (!HeapTupleIsValid(am)) elog(ERROR, "cache lookup failed for access method %u", amid); handler = ((Form_pg_am) GETSTRUCT(am))->amhandler; ReleaseSysCache(am); proc = SearchSysCache1(PROCOID, ObjectIdGetDatum(handler)); if (!HeapTupleIsValid(proc)) elog(ERROR, "cache lookup failed for function %u", handler); bin = SysCacheGetAttr(PROCOID, proc, Anum_pg_proc_probin, &isnull); *out = !isnull && strcmp(TextDatumGetCString(bin), "$libdir/doltgres_test") == 0 && strcmp(TextDatumGetCString(SysCacheGetAttrNotNull(PROCOID, proc, Anum_pg_proc_prosrc)), "dg_twin_handler") == 0; ReleaseSysCache(proc); }	test/t/030_handler.pl: a heap twin and its TOAST table keep heap's routine and its index nbtree's, while a fork table and a table USING heap are the fork's
