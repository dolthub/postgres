fold_horizon	uint64	Relation rel	raises	nocatalog	GetOldestNonRemovableTransactionId takes ProcArrayLock shared and reads the caller's database's horizon, which the Assert holds to the relation's; LWLockAcquire then takes it shared again to lower that horizon to the xmin and xid of each process in VACUUM the horizon covers, which ComputeXidHorizons passes over though a fold takes no lock that conflicts with VACUUM's, read through the PGPROC mirror of their flags, which ProcArrayEndTransaction clears at a transaction's end and InitProcess at a slot's reuse; it raises only past the held locks' limit	{ TransactionId horizon = GetOldestNonRemovableTransactionId(rel); bool shared = rel->rd_rel->relisshared; Assert(shared || rel->rd_locator.dbOid == MyDatabaseId || !OidIsValid(MyDatabaseId) || RecoveryInProgress()); LWLockAcquire(ProcArrayLock, LW_SHARED); for (int i = 0; i < ProcGlobal->allProcCount; i++) { PGPROC *proc = &ProcGlobal->allProcs[i]; uint8 flags = *(volatile uint8 *) &proc->statusFlags; TransactionId xmin = *(volatile TransactionId *) &proc->xmin; TransactionId xid = *(volatile TransactionId *) &proc->xid; if (!(flags & PROC_IN_VACUUM) || (!shared && proc->databaseId != rel->rd_locator.dbOid)) continue; if (TransactionIdIsNormal(xmin) && TransactionIdPrecedes(xmin, horizon)) horizon = xmin; if (TransactionIdIsNormal(xid) && TransactionIdPrecedes(xid, horizon)) horizon = xid; } LWLockRelease(ProcArrayLock); *out = U64FromFullTransactionId(FullTransactionIdFromAllowableAt(ReadNextFullTransactionId(), horizon)); }	test/t/050_fold.pl: a lazy VACUUM held paused holds back a fold of its database's table, and finishes after it
