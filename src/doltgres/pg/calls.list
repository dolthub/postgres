rekeyed_rows	void	Relation rel	raises	catalog	the table's update and its indexes' inserts run the fork's routines and the indexes' access methods, which read catalogs	EState *estate = CreateExecutorState(); ResultRelInfo *info = makeNode(ResultRelInfo); Snapshot snapshot = RegisterSnapshot(GetLatestSnapshot()); TupleTableSlot *slot = table_slot_create(rel, NULL); TableScanDesc scan; InitResultRelInfo(info, rel, 1, NULL, 0); ExecOpenIndices(info, false); scan = table_beginscan(rel, snapshot, 0, NULL, SO_NONE); while (table_scan_getnextslot(scan, ForwardScanDirection, slot)) { ItemPointerData tid = slot->tts_tid; TU_UpdateIndexes indexes; MemoryContext caller = MemoryContextSwitchTo(GetPerTupleMemoryContext(estate)); slot_getallattrs(slot); simple_table_tuple_update(rel, &tid, slot, snapshot, &indexes); if (info->ri_NumIndices > 0 && indexes != TU_None) ExecInsertIndexTuples(info, estate, indexes == TU_Summarizing ? EIIT_ONLY_SUMMARIZING : 0, slot, NIL, NULL); MemoryContextSwitchTo(caller); ResetPerTupleExprContext(estate); } table_endscan(scan); ExecDropSingleTupleTableSlot(slot); ExecCloseIndices(info); UnregisterSnapshot(snapshot); FreeExecutorState(estate)	test/t/067_layouts.pl: a keyless table's index scan agrees with its rows after a DROP COLUMN
