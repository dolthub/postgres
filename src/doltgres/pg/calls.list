old_entries_unchanged	bool	int32 at, int32 index, TupleTableSlot *old_row, TupleTableSlot *new_row	raises	nocatalog	pull_varattnos and bms_add_member allocate, which can raise out of memory, and slot_getallattrs deforms the rows; none reads the catalog	{ IndexInfo *info = doltgres_old_entries[at].infos[index]; TupleDesc desc = old_row->tts_tupleDescriptor; Bitmapset *attrs = NULL; int member = -1; for (int i = 0; i < info->ii_NumIndexAttrs; i++) if (info->ii_IndexAttrNumbers[i] != 0) attrs = bms_add_member(attrs, info->ii_IndexAttrNumbers[i] - FirstLowInvalidHeapAttributeNumber); pull_varattnos((Node *) info->ii_Expressions, 1, &attrs); pull_varattnos((Node *) info->ii_Predicate, 1, &attrs); slot_getallattrs(old_row); slot_getallattrs(new_row); *out = true; while ((member = bms_next_member(attrs, member)) >= 0) { int column = member + FirstLowInvalidHeapAttributeNumber - 1; Form_pg_attribute att; if (column < 0) { *out = false; break; } att = TupleDescAttr(desc, column); if (old_row->tts_isnull[column] != new_row->tts_isnull[column] || (!old_row->tts_isnull[column] && !datumIsEqual(old_row->tts_values[column], new_row->tts_values[column], att->attbyval, att->attlen))) { *out = false; break; } } bms_free(attrs); }	test/t/045_btree.pl: an UPDATE of a column a volatile expression index doesn't read calls its function no time, and one of a column it reads calls it once, as heap's twin's
