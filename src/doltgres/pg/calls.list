sort_begin_index	DoltgresSort *	Relation index	raises	catalog	get_opfamily_member reads pg_amop through the syscache, refusing a class without its operator as Postgres refuses one, and tuplesort_begin_heap allocates the sort in its own memory context, which can raise out of memory	{ int nkeys = IndexRelationGetNumberOfKeyAttributes(index); DoltgresSort *sort = palloc0(sizeof(DoltgresSort)); AttrNumber *attnums = palloc((nkeys + 2) * sizeof(AttrNumber)); Oid *operators = palloc((nkeys + 2) * sizeof(Oid)); Oid *collations = palloc((nkeys + 2) * sizeof(Oid)); bool *nulls_first = palloc((nkeys + 2) * sizeof(bool)); sort->desc = CreateTemplateTupleDesc(nkeys + 2); for (int i = 0; i < nkeys; i++) { int16 option = index->rd_indoption[i]; int16 strategy = (option & INDOPTION_DESC) ? BTGreaterStrategyNumber : BTLessStrategyNumber; TupleDescCopyEntry(sort->desc, i + 1, RelationGetDescr(index), i + 1); attnums[i] = i + 1; operators[i] = get_opfamily_member(index->rd_opfamily[i], index->rd_opcintype[i], index->rd_opcintype[i], strategy); if (!OidIsValid(operators[i])) elog(ERROR, "missing operator %d(%u,%u) in opfamily %u", strategy, index->rd_opcintype[i], index->rd_opcintype[i], index->rd_opfamily[i]); collations[i] = index->rd_indcollation[i]; nulls_first[i] = (option & INDOPTION_NULLS_FIRST) != 0; } for (int i = nkeys; i < nkeys + 2; i++) { TupleDescInitEntry(sort->desc, i + 1, NULL, BYTEAOID, -1, 0); attnums[i] = i + 1; operators[i] = ByteaLessOperator; collations[i] = InvalidOid; nulls_first[i] = false; } TupleDescFinalize(sort->desc); sort->state = tuplesort_begin_heap(sort->desc, nkeys + 2, attnums, operators, collations, nulls_first, maintenance_work_mem, NULL, TUPLESORT_NONE); sort->put = MakeSingleTupleTableSlot(sort->desc, &TTSOpsVirtual); sort->slot = MakeSingleTupleTableSlot(sort->desc, &TTSOpsMinimalTuple); *out = sort; }	test/t/045_btree.pl: an index built over a table's rows of a column compared through its class holds them in its class's order, and a unique one refuses two its class calls equal
