hash_enter	void *	HTAB *table, const void *key, uint32 hash	raises	nocatalog	a HASH_ENTER search raises only when the table is full; it reads no catalog	*out = hash_search_with_hash_value(table, key, hash, HASH_ENTER, NULL)	test/t/009_cache.pl: two backends read one node
hash_remove	void	HTAB *table, const void *key, uint32 hash	escalates	nocatalog	a HASH_REMOVE search raises only for a corrupted table, and anything raised becomes a PANIC; it reads no catalog	hash_search_with_hash_value(table, key, hash, HASH_REMOVE, NULL)	test/t/009_cache.pl: two backends read one node
owner_enlarge	ResourceOwner		raises	nocatalog	ResourceOwnerEnlarge raises only when memory runs out or the owner is releasing, and with no current owner the call raises instead of reading one; it reads no catalog	if (CurrentResourceOwner == NULL) elog(ERROR, "no resource owner for the fork's versioned state"); ResourceOwnerEnlarge(CurrentResourceOwner); *out = CurrentResourceOwner	test/t/009_cache.pl: a pin with no resource owner is refused
owner_remember	void	ResourceOwner owner, uint64 pin	noraise	nocatalog	ResourceOwnerRemember after ResourceOwnerEnlarge only stores into room the enlarge made	ResourceOwnerRemember(owner, UInt64GetDatum(pin), &doltgres_pin_desc)	test/t/009_cache.pl: a cursor's pin survives a rollback to a savepoint, and a subtransaction's abort releases only its own pins
owner_forget	void	ResourceOwner owner, uint64 pin	escalates	nocatalog	ResourceOwnerForget raises for a pin the owner doesn't remember, which the pin table rules out, since a live entry's owner remembers it, and for an owner that started releasing, which the pin kind's release before every other kind rules out, since an owner's pins have no entry by the time another kind's release drops one; anything raised becomes a PANIC; it reads no catalog	ResourceOwnerForget(owner, UInt64GetDatum(pin), &doltgres_pin_desc)	test/t/009_cache.pl: a cursor's pin survives a rollback to a savepoint, and a subtransaction's abort releases only its own pins
owned_remember	void	ResourceOwner owner, uint64 record	noraise	nocatalog	ResourceOwnerRemember after ResourceOwnerEnlarge only stores into room the enlarge made	ResourceOwnerRemember(owner, UInt64GetDatum(record), &doltgres_owned_desc)	test/t/031_owned.pl: a record outlives the call that made it and is lent to the next by its handle
