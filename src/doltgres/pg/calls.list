rel_key_columns	int	Relation rel, DgKeyColumn *columns	raises	catalog	it reads the relation's primary key index as relcache.c does, a deferrable one too, since a table whose primary key is DEFERRABLE is keyed by it (STORAGE_DESIGN §II.7), and its pg_index row through one INDEXRELID lookup, refusing a missing row with relcache.c's words, and fills one entry a key column, its attnum, its type, its operator class from indclass, and its collation from indcollation, in index column order, into an array of INDEX_MAX_KEYS entries, which pg_index's indnkeyatts never passes; a primary key is always ascending with nulls last, since parse_utilcmd.c refuses any other (42809), so its indoption says nothing more	Oid index = RelationGetPrimaryKeyIndex(rel, true); *out = 0; if (OidIsValid(index)) { HeapTuple t = SearchSysCache1(INDEXRELID, ObjectIdGetDatum(index)); Form_pg_index form; oidvector *classes; oidvector *collations; if (!HeapTupleIsValid(t)) elog(ERROR, "cache lookup failed for index %u", index); form = (Form_pg_index) GETSTRUCT(t); classes = (oidvector *) DatumGetPointer(SysCacheGetAttrNotNull(INDEXRELID, t, Anum_pg_index_indclass)); collations = (oidvector *) DatumGetPointer(SysCacheGetAttrNotNull(INDEXRELID, t, Anum_pg_index_indcollation)); while (*out < form->indnkeyatts) { AttrNumber att = form->indkey.values[*out]; columns[*out].attnum = att; columns[*out].type = TupleDescAttr(RelationGetDescr(rel), att - 1)->atttypid; columns[*out].class_ = classes->values[*out]; columns[*out].collation = collations->values[*out]; (*out)++; } ReleaseSysCache(t); }	test/t/033_scan.pl: a scan of a table keyed by later columns gives its rows in key order
