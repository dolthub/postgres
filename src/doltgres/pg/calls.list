fold_as_owner	bool	Oid relid, Oid relfilenode	raises	catalog	in a transaction of its own it opens the relation, an index's table before it, as Postgres locks a table before its indexes, which reads its catalog, and passes over one gone or rewritten since, or one whose lock another transaction holds, as a transaction that made or truncated the table holds it while its writes wait at delta_memory for the folds of the others; it runs the fold as the relation's owner in a security-restricted operation with search_path restricted and every user-settable setting at its built-in default (PLAN item 6's User code in folds), lc_messages at C because its built-in empty value, the environment's locale, is one only the server's start may set, set at a GUC nest level the commit undoes, as VACUUM runs index functions	{ Relation rel = NULL; Relation heap = NULL; Oid heapid; Oid saved_user; int saved_context; StartTransactionCommand(); PushActiveSnapshot(GetTransactionSnapshot()); heapid = IndexGetRelation(relid, true); if (OidIsValid(heapid) && ConditionalLockRelationOid(heapid, AccessShareLock) && (heap = try_relation_open(heapid, NoLock)) == NULL) UnlockRelationOid(heapid, AccessShareLock); if ((!OidIsValid(heapid) || heap != NULL) && ConditionalLockRelationOid(relid, AccessShareLock) && (rel = try_relation_open(relid, NoLock)) == NULL) UnlockRelationOid(relid, AccessShareLock); *out = false; if (rel != NULL && rel->rd_locator.relNumber == relfilenode && (rel->rd_index == NULL || heap != NULL)) { int level; GetUserIdAndSecContext(&saved_user, &saved_context); SetUserIdAndSecContext(rel->rd_rel->relowner, saved_context | SECURITY_RESTRICTED_OPERATION); level = NewGUCNestLevel(); { int count; struct config_generic **vars = get_guc_variables(&count); for (int at = 0; at < count; at++) { struct config_generic *var = vars[at]; const char *value = NULL; char number[64]; if ((var->context != PGC_SUSET && var->context != PGC_USERSET) || (var->flags & GUC_NO_RESET_ALL)) continue; switch (var->vartype) { case PGC_BOOL: value = var->_bool.boot_val ? "on" : "off"; break; case PGC_INT: snprintf(number, sizeof(number), "%d", var->_int.boot_val); value = number; break; case PGC_REAL: snprintf(number, sizeof(number), "%.17g", var->_real.boot_val); value = number; break; case PGC_STRING: value = strcmp(var->name, "lc_messages") == 0 ? "C" : var->_string.boot_val; break; case PGC_ENUM: value = config_enum_lookup_by_value(var, var->_enum.boot_val); break; } if (value != NULL) (void) set_config_option(var->name, value, PGC_SUSET, PGC_S_SESSION, GUC_ACTION_SAVE, true, ERROR, false); } } RestrictSearchPath(); *out = doltgres_fold_relation(rel, heap != NULL ? heap : rel); AtEOXact_GUC(false, level); SetUserIdAndSecContext(saved_user, saved_context); } if (rel != NULL) relation_close(rel, AccessShareLock); if (heap != NULL) relation_close(heap, AccessShareLock); PopActiveSnapshot(); CommitTransactionCommand(); }	test/t/062_fold_trigger.pl: a fold orders a user comparator's keys under the built-in settings, not the server's
