# Every Postgres function or macro the fork's Rust calls (design item 17), one per line, tab-separated: the name of
# its wrapper, the C return type, the C parameters, whether it can raise (raises, noraise, or escalates, which can't
# raise into Rust since its wrapper turns anything raised into a PANIC), whether it can reach a catalog (catalog or
# nocatalog), the reason for each noraise, escalates, or nocatalog mark from Postgres' source, the C the wrapper
# evaluates (the statements of a void wrapper or of a raising one that sets `*out`, separated by "; " outside braces,
# in which a raising wrapper may name `context`, the memory context its call began in), and the test that exercises
# the wrapper. The build generates the C wrapper, which catches what it raises, and its Rust function, unsafe when it
# takes a pointer; a `DgBytes` or `DgBuffer` parameter is a Rust slice's pointer and length, borrowed for the call, and
# an `XLogReaderState *` or `StringInfo` one is the record or description Postgres handed an entry, borrowed from it.
# A wrapper that doesn't raise, noraise or escalating, holds interrupts across its call, so a report below ERROR inside
# it, its own or one of a function it calls, takes no pending cancel.

injection_point	void	const char *name	raises	nocatalog	InjectionPointRun reads no catalog, and the callbacks it runs are the test modules', which read none	INJECTION_POINT(name, NULL)	test/t/001_binding.pl: an error inside a wrapped call comes back unchanged
text_datum	Datum	const char *s	raises	nocatalog	cstring_to_text only allocates	CStringGetTextDatum(s)	test/t/001_binding.pl: dolt_version gives the fork's version
hold_interrupts	void		noraise	nocatalog	HOLD_INTERRUPTS only counts	HOLD_INTERRUPTS()	test/t/001_binding.pl: a cancel after an error inside a wrapped call is honored
resume_interrupts	void		noraise	nocatalog	RESUME_INTERRUPTS only counts	RESUME_INTERRUPTS()	test/t/001_binding.pl: a cancel after an error inside a wrapped call is honored
injection_point_attached	bool	const char *name	raises	nocatalog	IsInjectionPointAttached reads only shared memory	IS_INJECTION_POINT_ATTACHED(name)	test/t/001_binding.pl: a panic in an entry is an internal error
is_under_postmaster	bool		noraise	nocatalog	IsUnderPostmaster is a variable	IsUnderPostmaster	test/t/002_preload.pl: the postmaster fails to start when its preload entry fails to allocate
register_shmem	void		raises	nocatalog	RegisterShmemCallbacks only records the callbacks, and raises outside the preload window; it reads no catalog	RegisterShmemCallbacks(&doltgres_shmem_callbacks)	test/t/003_shmem.pl: the versioned shared memory region is listed
request_shmem	void	size_t size	raises	nocatalog	ShmemRequestStruct only records the request; it reads no catalog	ShmemRequestStruct(.name = "versioned shared memory", .size = size, .ptr = &doltgres_shmem_base)	test/t/003_shmem.pl: the versioned shared memory region is listed
shmem_base	void *		noraise	nocatalog	doltgres_shmem_base is a variable	doltgres_shmem_base	test/t/003_shmem.pl: a backend waiting on the fork's lock sees the value the holder stored
new_tranche	int	const char *name	raises	nocatalog	LWLockNewTrancheId raises only when the tranche ids run out; it reads no catalog	LWLockNewTrancheId(name)	test/t/003_shmem.pl: the second backend waits on the fork's lock
lwlock_initialize	void	LWLock *lock, int tranche	noraise	nocatalog	LWLockInitialize only sets the lock's fields	LWLockInitialize(lock, tranche)	test/t/003_shmem.pl: a backend waiting on the fork's lock sees the value the holder stored
lwlock_acquire	void	LWLock *lock, LWLockMode mode	raises	nocatalog	LWLockAcquire raises only when too many locks are held; it reads no catalog	LWLockAcquire(lock, mode)	test/t/003_shmem.pl: the second backend waits on the fork's lock
lwlock_release	void	LWLock *lock	escalates	nocatalog	LWLockRelease raises only for a lock this backend doesn't hold, which shmem's guard, its only caller, rules out by construction, and anything raised becomes a PANIC; it runs no fork code	LWLockRelease(lock)	test/t/003_shmem.pl: a backend waiting on the fork's lock sees the value the holder stored
start_crit_section	void		noraise	nocatalog	START_CRIT_SECTION only counts	START_CRIT_SECTION()	test/t/003_shmem.pl: a backend waiting on the fork's lock sees the value the holder stored
end_crit_section	void		noraise	nocatalog	END_CRIT_SECTION only counts	END_CRIT_SECTION()	test/t/003_shmem.pl: a backend waiting on the fork's lock sees the value the holder stored
current_timestamp	int64		noraise	nocatalog	GetCurrentTimestamp only reads the clock	GetCurrentTimestamp()	test/t/004_host.pl: the host's time of day is the server's clock
my_proc_pid	int		noraise	nocatalog	MyProcPid is a variable	MyProcPid	test/t/004_host.pl: the host's process id is the backend's
wait_event_new	uint32	const char *name	raises	nocatalog	WaitEventExtensionNew raises only when the custom wait events run out; it reads no catalog	WaitEventExtensionNew(name)	test/t/005_file.pl: the file door's wait events are registered
strong_random	void	DgBuffer buffer	raises	nocatalog	pg_strong_random reads the system's source of random bytes; it reads no catalog	if (!pg_strong_random(buffer.data, buffer.len)) ereport(ERROR, (errcode(ERRCODE_INTERNAL_ERROR), errmsg("could not generate random values")))	test/t/017_pages.pl: two backends read one seed of the delta's shapes
file_open	int	const char *path, int how	raises	nocatalog	PathNameOpenFile opens a file through the VFD cache; it reads no catalog	*out = PathNameOpenFile(path, PG_BINARY | (how == 0 ? O_RDONLY : how == 1 ? O_RDWR : O_RDWR | O_CREAT | O_EXCL)); if (*out < 0) ereport(ERROR, errcode_for_file_access(), errmsg("could not open file \"%s\": %m", path))	test/t/005_file.pl: a file written and synced reads back
file_read	void	int file, DgBuffer buffer, int64 offset, uint32 wait	raises	nocatalog	FileRead reads through the VFD cache; it reads no catalog	{ size_t done = 0; while (done < buffer.len) { ssize_t n = FileRead(file, buffer.data + done, buffer.len - done, offset + done, wait); if (n < 0) ereport(ERROR, errcode_for_file_access(), errmsg("could not read file \"%s\": %m", FilePathName(file))); if (n == 0) ereport(ERROR, errcode(ERRCODE_DATA_CORRUPTED), errmsg("could not read file \"%s\": read %zu of %zu", FilePathName(file), done, buffer.len)); done += n; } }	test/t/005_file.pl: a read past the end of a file is a short read
file_write	void	int file, DgBytes bytes, int64 offset, uint32 wait	raises	nocatalog	FileWrite writes through the VFD cache; it reads no catalog	{ size_t done = 0; INJECTION_POINT("doltgres-file-write", NULL); while (done < bytes.len) { ssize_t n = FileWrite(file, bytes.data + done, bytes.len - done, offset + done, wait); if (n <= 0) ereport(ERROR, errcode_for_file_access(), errmsg("could not write to file \"%s\": %m", FilePathName(file))); done += n; } }	test/t/005_file.pl: an error raised inside a file write comes back unchanged
file_size	int64	int file	raises	nocatalog	FileSize seeks through the VFD cache; it reads no catalog	*out = FileSize(file); if (*out < 0) ereport(ERROR, errcode_for_file_access(), errmsg("could not seek to end of file \"%s\": %m", FilePathName(file)))	test/t/005_file.pl: a file written and synced reads back
file_truncate	void	int file, int64 len, uint32 wait	raises	nocatalog	FileTruncate truncates through the VFD cache; it reads no catalog	if (FileTruncate(file, len, wait) < 0) ereport(ERROR, errcode_for_file_access(), errmsg("could not truncate file \"%s\": %m", FilePathName(file)))	test/t/005_file.pl: a truncated file has the length it was cut to
file_sync	void	int file, uint32 wait	raises	nocatalog	FileSync syncs through the VFD cache with pg_fsync; it reads no catalog	if (FileSync(file, wait) < 0) ereport(data_sync_elevel(ERROR), errcode_for_file_access(), errmsg("could not fsync file \"%s\": %m", FilePathName(file)))	test/t/005_file.pl: a file written and synced reads back
file_prefetch	void	int file, int64 offset, int64 len, uint32 wait	escalates	nocatalog	FilePrefetch returns any failure to advise the operating system instead of raising it, but opening the file's descriptor can close another file's, and a failed close there is reported at LOG (a temporary file's always, any file's with data_sync_retry on): interrupts are held across the call, so that report takes no pending cancel, and anything raised becomes a PANIC	(void) FilePrefetch(file, offset, len, wait)	test/t/005_file.pl: a prefetch never raises
file_close	void	int file	escalates	nocatalog	FileClose reports a failure to close at LOG and returns: interrupts are held across it, so the report takes no pending cancel, and anything raised becomes a PANIC; a temporary file's close also reports its size, deletes it, logging a failure, and has its resource owner forget it, which raises only for an owner that is releasing or never remembered the file, and a scratch file is closed by the entry that opened it, before its owner's release; it runs no fork code, and its injection point runs only a test's callback	INJECTION_POINT("doltgres-file-close", NULL); FileClose(file)	test/t/005_file.pl: an error between opening and closing a file closes it
durable_rename	void	const char *from, const char *to	raises	nocatalog	durable_rename renames and syncs files and their directory; it reads no catalog	(void) durable_rename(from, to, ERROR)	test/t/005_file.pl: a durable rename moves the file
durable_unlink	void	const char *path	raises	nocatalog	durable_unlink removes a file and syncs its directory; it reads no catalog	(void) durable_unlink(path, ERROR)	test/t/005_file.pl: a durable removal removes the file
fsync_fname	void	const char *path, bool directory	raises	nocatalog	fsync_fname syncs a file or directory with pg_fsync; it reads no catalog	fsync_fname(path, directory)	test/t/005_file.pl: a durable rename moves the file
make_directory	void	const char *path	raises	nocatalog	MakePGDirectory only makes a directory; it reads no catalog	if (MakePGDirectory(path) < 0 && errno != EEXIST) ereport(ERROR, errcode_for_file_access(), errmsg("could not create directory \"%s\": %m", path))	test/t/005_file.pl: a file written and synced reads back
list_dir	size_t	const char *path, DgBuffer names	raises	nocatalog	AllocateDir and ReadDir read a directory, and FreeDir frees it; they read no catalog	{ DIR *dir = AllocateDir(path); struct dirent *de; size_t used = 0; while ((de = ReadDir(dir, path)) != NULL) { size_t len = strlen(de->d_name) + 1; if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue; if (used + len <= names.len) memcpy(names.data + used, de->d_name, len); used += len; } FreeDir(dir); *out = used; }	test/t/005_file.pl: a durable rename moves the file
register_rmgr	void		noraise	nocatalog	it does exactly RegisterCustomRmgr's store without its LOG line, which stock's initdb and server logs don't have, and each of RegisterCustomRmgr's checks holds at the preload call site: the name and id are globals.list's constants, the call runs while preload is in progress, and it runs before load_libraries, so no library has registered the id or the name, and a library that registers either later fails RegisterCustomRmgr's own checks against this entry	RmgrTable[doltgres_rmgr_id] = doltgres_rmgr	test/t/006_wal.pl: the server log has no line for the resource manager
wal_insert	uint64	uint8 kind, DgBytes body	raises	nocatalog	XLogInsert writes into the WAL buffers; it reads no catalog	if (body.len == 0) elog(ERROR, "versioned WAL record of kind %u holds no data", kind); if (body.len > XLogRecordMaxSize) ereport(ERROR, errmsg_internal("oversized WAL record"), errdetail_internal("WAL record would be %zu bytes (of maximum %u bytes); rmid %u flags %u.", body.len, XLogRecordMaxSize, doltgres_rmgr_id, kind << 4)); XLogBeginInsert(); XLogRegisterData(body.data, body.len); *out = XLogInsert(doltgres_rmgr_id, kind << 4)	test/t/006_wal.pl: a record without data is refused
wal_flush	void	uint64 lsn	raises	nocatalog	XLogFlush writes and syncs the WAL; it reads no catalog	XLogFlush(lsn)	test/t/006_wal.pl: a flushed record is durable
record_info	uint8	XLogReaderState *record	noraise	nocatalog	XLogRecGetInfo reads the decoded record	XLogRecGetInfo(record) & ~XLR_INFO_MASK	test/t/006_wal.pl: redo applies the fork's records after a crash
record_data	DgBytes	XLogReaderState *record	noraise	nocatalog	XLogRecGetData and XLogRecGetDataLen read the decoded record	(DgBytes) {XLogRecGetData(record), XLogRecGetDataLen(record)}	test/t/006_wal.pl: redo applies the fork's records after a crash
desc_append	void	StringInfo buf, DgBytes text	raises	nocatalog	appendBinaryStringInfo raises only when the buffer can't grow; it reads no catalog	appendBinaryStringInfo(buf, text.data, text.len)	test/t/006_wal.pl: the fork's records show in pg_walinspect
unknown_kind	void	uint8 info	noraise	nocatalog	elog(PANIC) ends the process without returning	elog(PANIC, "versioned_redo: unknown op code %u", info)	test/t/006_wal.pl: a record of an unknown kind stops recovery
delay_checkpoints	void		raises	nocatalog	the checks raise only for a misplaced window; it reads no catalog	if (MyProc == NULL || !LocalTransactionIdIsValid(MyProc->vxid.lxid)) elog(ERROR, "cannot delay a checkpoint outside a transaction"); if (MyProc->delayChkptFlags & DELAY_CHKPT_START) elog(ERROR, "cannot delay a checkpoint inside another delay"); START_CRIT_SECTION(); MyProc->delayChkptFlags |= DELAY_CHKPT_START	test/t/006_wal.pl: a checkpoint waits for the delay guard
resume_checkpoints	void	bool finished	noraise	nocatalog	it raises only a PANIC, which ends the process without returning, and otherwise clears a flag of MyProc and ends the critical section	if (!finished) elog(PANIC, "checkpoint delay ended before its change was made visible"); if ((MyProc->delayChkptFlags & DELAY_CHKPT_START) == 0) elog(PANIC, "checkpoint delay was cleared inside its window"); MyProc->delayChkptFlags &= ~DELAY_CHKPT_START; END_CRIT_SECTION()	test/t/006_wal.pl: a delay that ends unfinished stops the server
check_interrupts	void		raises	nocatalog	ProcessInterrupts raises only the error a pending interrupt calls for; it reads no catalog	CHECK_FOR_INTERRUPTS()	test/t/004_host.pl: a pending cancel stops a loop at its next check
rename_file	void	const char *from, const char *to	raises	nocatalog	the port layer's rename renames a file; it reads no catalog	if (rename(from, to) < 0) ereport(ERROR, errcode_for_file_access(), errmsg("could not rename file \"%s\" to \"%s\": %m", from, to))	test/t/005_file.pl: a rename shows in the folder once synced
lwlock_held	bool	LWLock *lock	noraise	nocatalog	LWLockHeldByMe only reads the backend's list of held locks	LWLockHeldByMe(lock)	test/t/007_shared.pl: a second take of a held lock is refused
atomic_init_u64	void	pg_atomic_uint64 *atomic, uint64 value	noraise	nocatalog	pg_atomic_init_u64 only writes	pg_atomic_init_u64(atomic, value)	test/t/007_shared.pl: an atomic changed by one backend is read by another
atomic_read_u64	uint64	pg_atomic_uint64 *atomic	noraise	nocatalog	pg_atomic_read_u64 only reads	pg_atomic_read_u64(atomic)	test/t/007_shared.pl: an atomic changed by one backend is read by another
atomic_write_u64	void	pg_atomic_uint64 *atomic, uint64 value	noraise	nocatalog	pg_atomic_write_u64 only writes	pg_atomic_write_u64(atomic, value)	test/t/007_shared.pl: an atomic changed by one backend is read by another
atomic_add_u64	uint64	pg_atomic_uint64 *atomic, int64 add	noraise	nocatalog	pg_atomic_fetch_add_u64 only adds	pg_atomic_fetch_add_u64(atomic, add)	test/t/007_shared.pl: an atomic changed by one backend is read by another
atomic_exchange_u64	void	pg_atomic_uint64 *atomic, uint64 *seen, uint64 value	noraise	nocatalog	pg_atomic_compare_exchange_u64 only compares and writes	pg_atomic_compare_exchange_u64(atomic, seen, value)	test/t/007_shared.pl: an atomic changed by one backend is read by another
atomic_init_u32	void	pg_atomic_uint32 *atomic, uint32 value	noraise	nocatalog	pg_atomic_init_u32 only writes	pg_atomic_init_u32(atomic, value)	test/t/007_shared.pl: a flag another backend holds is waited for and a cancel ends the wait
atomic_write_u32	void	pg_atomic_uint32 *atomic, uint32 value	noraise	nocatalog	pg_atomic_write_u32 only writes	pg_atomic_write_u32(atomic, value)	test/t/007_shared.pl: a flag another backend holds is waited for and a cancel ends the wait
atomic_exchange_u32	void	pg_atomic_uint32 *atomic, uint32 *seen, uint32 value	noraise	nocatalog	pg_atomic_compare_exchange_u32 only compares and writes	pg_atomic_compare_exchange_u32(atomic, seen, value)	test/t/007_shared.pl: a flag another backend holds is waited for and a cancel ends the wait
cv_init	void	ConditionVariable *cv	noraise	nocatalog	ConditionVariableInit only initializes the variable's spinlock and wait list	ConditionVariableInit(cv)	test/t/007_shared.pl: a flag another backend holds is waited for and a cancel ends the wait
cv_sleep	void	ConditionVariable *cv, uint32 wait	raises	nocatalog	ConditionVariableSleep raises only what CHECK_FOR_INTERRUPTS does; it reads no catalog	ConditionVariableSleep(cv, wait)	test/t/007_shared.pl: a flag another backend holds is waited for and a cancel ends the wait
cv_cancel	void		noraise	nocatalog	ConditionVariableCancelSleep only takes the process off a wait list under a spinlock	(void) ConditionVariableCancelSleep()	test/t/007_shared.pl: a flag another backend holds is waited for and a cancel ends the wait
cv_broadcast	void	ConditionVariable *cv	noraise	nocatalog	ConditionVariableBroadcast only sets the waiters' latches under a spinlock	ConditionVariableBroadcast(cv)	test/t/007_shared.pl: a flag another backend holds is waited for and a cancel ends the wait
my_proc_number	int		noraise	nocatalog	MyProcNumber is a variable	MyProcNumber	test/t/007_shared.pl: a flag another backend holds is waited for and a cancel ends the wait
max_procs	int		noraise	nocatalog	MaxBackends and NUM_AUXILIARY_PROCS are set before shared memory is	MaxBackends + NUM_AUXILIARY_PROCS	test/t/007_shared.pl: the oldest epoch is a paused reader's until it ends
relation_locks	size_t		raises	nocatalog	the shared lock table's entries as lock.c's NLOCKENTS sizes them, and every backend's fast-path slots, their groups computed as postinit.c's InitializeFastPathLocks computes them, since an EXEC_BACKEND child's request callbacks run before it (ipci.c's AttachSharedMemoryStructs) and FastPathLockSlotsPerBackend() reads 0 there; mul_size and add_size raise only on an overflow, as Postgres' own sizing does; it reads no catalog	*out = add_size(mul_size(max_locks_per_xact, add_size(MaxBackends, max_prepared_xacts)), mul_size(MaxBackends, mul_size(Max(Min(pg_nextpower2_32(max_locks_per_xact) / FP_LOCK_SLOTS_PER_GROUP, FP_LOCK_GROUPS_PER_BACKEND_MAX), 1), FP_LOCK_SLOTS_PER_GROUP)))	test/t/032_state.pl: the storage states' pool holds a state for each relation lock a backend's own globals count
canonicalize_path	void	DgBuffer path	noraise	nocatalog	canonicalize_path rewrites a NUL-terminated path in its own bytes and calls nothing that raises or allocates	canonicalize_path(path.data)	test/t/005_file.pl: a read past the end of a file is a short read
request_cache	void	size_t size	raises	nocatalog	ShmemRequestStruct only records the request; it reads no catalog	ShmemRequestStruct(.name = "versioned node cache", .size = size, .ptr = &doltgres_cache_base)	test/t/009_cache.pl: the versioned node cache is listed with its size
request_cache_table	void	int64 entries, size_t key, size_t entry	raises	nocatalog	ShmemRequestHash only records the request; it reads no catalog	ShmemRequestHash(.name = "versioned node cache table", .nelems = entries, .hash_info.keysize = key, .hash_info.entrysize = entry, .hash_info.num_partitions = 128, .hash_flags = HASH_ELEM | HASH_BLOBS | HASH_PARTITION | HASH_FIXED_SIZE, .ptr = &doltgres_cache_table)	test/t/009_cache.pl: the versioned node cache is listed with its size
cache_base	void *		noraise	nocatalog	doltgres_cache_base is a variable	doltgres_cache_base	test/t/009_cache.pl: two backends read one node
