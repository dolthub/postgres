# Every function Postgres calls in the fork (design item 17), one per line, tab-separated: its name, the C return
# type, the C parameters, what a panic in it becomes (error or panic), whether it runs with catalog access (catalog
# or nocatalog), the reason for the marks, and the test that exercises the entry. The build generates the C entry
# thunk, which raises what the Rust implementation returns, and `export_entries!`, which `doltgres` expands into the
# exported Rust side.

doltgres_shared_preload	void		error	nocatalog	the preload window runs before any transaction	test/t/002_preload.pl: the postmaster fails to start when its preload entry fails to allocate
doltgres_dolt_version	Datum	FunctionCallInfo fcinfo	error	catalog	SQL functions run inside a transaction	test/t/001_binding.pl: dolt_version gives the fork's version
doltgres_shmem_request	void	void *arg	error	nocatalog	the postmaster requests shared memory before any transaction	test/t/003_shmem.pl: the versioned shared memory region is listed
doltgres_shmem_init	void	void *arg	error	nocatalog	the postmaster initializes shared memory before any transaction	test/t/003_shmem.pl: a backend waiting on the fork's lock sees the value the holder stored
doltgres_shared_release	void	int code, Datum arg	panic	nocatalog	before_shmem_exit runs while the process exits	test/t/007_shared.pl: a holder terminated by pg_terminate_backend is closed at its exit
doltgres_rmgr_redo	void	XLogReaderState *record	error	nocatalog	redo runs in the startup process, which has no catalog access (design item 8)	test/t/006_wal.pl: redo applies the fork's records after a crash
doltgres_rmgr_desc	void	StringInfo buf, XLogReaderState *record	error	nocatalog	a record's description reads only its bytes	test/t/006_wal.pl: the fork's records show in pg_walinspect
doltgres_rmgr_identify	const char *	uint8 info	error	nocatalog	a record's name reads only its info	test/t/006_wal.pl: the fork's records show in pg_walinspect
doltgres_shared_exit	void	int code, Datum arg	error	nocatalog	before_shmem_exit runs it as the process exits, before the callback that releases what may not raise; an error in it ends the process with a FATAL, after which Postgres runs the callbacks left	test/t/009_cache.pl: a terminated backend's pins are released
doltgres_cache_release	void	uint64 res	panic	nocatalog	a resource owner releases a pin inside an abort, where nothing may raise; the release only removes the pin's entry and counts its frame down	test/t/009_cache.pl: a cursor's pin survives a rollback to a savepoint, and a subtransaction's abort releases only its own pins
doltgres_owned_release	void	uint64 res	panic	nocatalog	a resource owner releases an owned record inside an abort, where nothing may raise; the release only takes the record out of its table and drops it	test/t/031_owned.pl: an ERROR's release drops a record whose end never came, raising nothing
doltgres_process_start	void		error	nocatalog	BaseInit runs before any transaction, in every process that has a PGPROC	test/t/016_exit_doors.pl: a callback registered and cancelled around a backend's first use of shared records raises nothing
doltgres_libc_locale	bool	Oid collid, MemoryContext context, pg_locale_t *result	error	catalog	Postgres builds a locale inside a transaction, from its catalog's row	test/t/022_libc_locale.pl: a libc collation orders, compares, and maps case as the collator of its name's tag
doltgres_libc_new_locale	bool	Oid collid, MemoryContext context, DgLibcLocale loc, pg_locale_t *result	error	catalog	Postgres builds a locale inside a transaction, from its catalog's row	test/t/022_libc_locale.pl: a new collation of a name the C library doesn't know raises Postgres' error
doltgres_new_collation	bool	Oid collid, const DefElem *from	error	catalog	Postgres checks a new collation inside the transaction that made it, from its catalog's row	test/t/022_libc_locale.pl: a new collation of a name the C library doesn't know raises Postgres' error
doltgres_icu_locale	bool	Oid collid, const char **iculocstr	error	catalog	Postgres builds a locale inside a transaction, from its catalog's row	test/t/022_libc_locale.pl: a libc collation orders, compares, and maps case as the collator of its name's tag
doltgres_builtin_locale	bool	Oid collid, const char **locstr	error	catalog	Postgres builds a locale inside a transaction, from its catalog's row	test/t/022_libc_locale.pl: a libc pair of the C family but C and POSIX alone is the builtin provider's locale of its ctype name
doltgres_libc_collversion	bool	const char *collcollate, char **collversion	error	catalog	Postgres asks a collation's version inside a transaction	test/t/022_libc_locale.pl: a libc collation reports the collator's version
doltgres_checkpoint	void	uint64 redo	error	nocatalog	CheckPointGuts runs in the checkpointer, or a standalone backend, outside any transaction	test/t/023_kept_wal.pl: a checkpoint with only initdb's repositories recycles WAL as Postgres does
doltgres_kept_segment	int64	int64 segment, int segment_size	error	nocatalog	KeepLogSeg runs outside a critical section, in the checkpointer or a backend reading a slot's WAL	test/t/023_kept_wal.pl: a checkpoint with only initdb's repositories recycles WAL as Postgres does
doltgres_startup_open	void	uint64 redo, uint64 label	error	nocatalog	StartupXLOG runs before any transaction, in the startup process or a standalone backend	test/t/024_startup_open.pl: a start with only initdb's repositories logs nothing of the fork's
doltgres_createdb	void	Oid template_id, Oid database_id, Oid tablespace_id	error	catalog	createdb runs inside its transaction	test/t/041_database.pl: a new database has a repository
doltgres_dropdb	void	Oid database_id	error	catalog	dropdb runs inside its transaction	test/t/041_database.pl: a dropped database's repository is gone at once
doltgres_db_file_conflict	bool	Oid database_id	error	catalog	createdb chooses the new database's id inside its transaction	test/t/041_database.pl: an id whose repository's directory stands is refused
doltgres_movedb_copy	void	Oid database_id, Oid from_tablespace, Oid to_tablespace	error	catalog	movedb copies inside its transaction	test/t/041_database.pl: a moved database's repository is in its new tablespace and gone from the old
doltgres_movedb_finish	void	Oid database_id, Oid from_tablespace, Oid to_tablespace	error	catalog	movedb finishes inside the transaction it starts after its commit	test/t/041_database.pl: a moved database's repository is in its new tablespace and gone from the old
doltgres_slot_init	void	TupleTableSlot *slot	error	nocatalog	a slot's callbacks read only the slot and its descriptor	test/t/029_slot.pl: a row stored in the fork's slot reads back as heap's own row
doltgres_slot_release	void	TupleTableSlot *slot	panic	nocatalog	a slot is cleared and released while a transaction aborts and memory is reset, where nothing may raise	test/t/029_slot.pl: a cleared slot is empty and takes another row
doltgres_slot_clear	void	TupleTableSlot *slot	panic	nocatalog	a slot is cleared and released while a transaction aborts and memory is reset, where nothing may raise	test/t/029_slot.pl: a cleared slot is empty and takes another row
doltgres_slot_getsomeattrs	void	TupleTableSlot *slot, int natts	error	nocatalog	a slot's callbacks read only the slot and its descriptor	test/t/029_slot.pl: a row stored in the fork's slot reads back as heap's own row
doltgres_slot_getsysattr	Datum	TupleTableSlot *slot, int attnum, bool *isnull	error	nocatalog	a slot's callbacks read only the slot and its descriptor	test/t/029_slot.pl: a stored row's system attribute is read from its version
doltgres_slot_is_current_xact_tuple	bool	TupleTableSlot *slot	error	nocatalog	a slot's callbacks read only the slot and its descriptor	test/t/029_slot.pl: a stored row's system attribute is read from its version
doltgres_slot_materialize	void	TupleTableSlot *slot	error	nocatalog	a slot's callbacks read only the slot and its descriptor	test/t/029_slot.pl: a row copied from a slot of another kind reads back the same
doltgres_slot_copyslot	void	TupleTableSlot *dstslot, TupleTableSlot *srcslot	error	nocatalog	a slot's callbacks read only the slot and its descriptor; its two exclusive borrows rest on Postgres never handing one slot as both, which is ExecCopySlot's own condition	test/t/029_slot.pl: a row copied from a slot of the fork's kind reads back the same
doltgres_slot_copy_heap_tuple	HeapTuple	TupleTableSlot *slot	error	nocatalog	a slot's callbacks read only the slot and its descriptor	test/t/029_slot.pl: a heap tuple of the slot holds the same row
doltgres_slot_copy_minimal_tuple	MinimalTuple	TupleTableSlot *slot, Size extra	error	nocatalog	a slot's callbacks read only the slot and its descriptor	test/t/029_slot.pl: a minimal tuple of the slot holds the same row
doltgres_table_am_routine	bool	Relation relation, const TableAmRoutine **routine	error	catalog	the rule reads the relation's relcache entry and the backend's own record of the relation being created, and in a build with injection points its access method's pg_am and pg_proc rows, inside the transaction that builds the entry	test/t/030_handler.pl: of a user's relations of every kind, the tables, materialized views, and TOAST tables are the fork's
doltgres_relation_creating	void	Oid relid, Oid relrewrite	error	nocatalog	it records two numbers for the backend, before the relation exists	test/t/030_handler.pl: a relation being created answers by what its creator said it rewrites, in that transaction level alone
doltgres_table_slot_callbacks	const TupleTableSlotOps *	Relation rel	error	nocatalog	it names the fork's kind of slot	test/t/030_handler.pl: of a user's relations of every kind, the tables, materialized views, and TOAST tables are the fork's
doltgres_scan_begin	TableScanDesc	Relation relation, Snapshot snapshot, int nkeys, ScanKey key, ParallelTableScanDesc pscan, uint32 flags	error	catalog	a scan begins inside a transaction, and its begin reads the relation's relcache entry and takes its predicate lock	test/t/033_scan.pl: a seq scan of a table on the fork's storage gives its base's rows
doltgres_scan_getnextslot	bool	TableScanDesc scan, ScanDirection direction, TupleTableSlot *slot	error	catalog	a scan reads inside a transaction, and its keys' support functions may read any catalog	test/t/033_scan.pl: a seq scan of a table on the fork's storage gives its base's rows
doltgres_scan_rescan	void	TableScanDesc scan, ScanKey key, bool set_params, bool allow_strat, bool allow_sync, bool allow_pagemode	error	nocatalog	a rescan updates the scan's flags and keys and starts its record over	test/t/033_scan.pl: a seq scan of a table on the fork's storage gives its base's rows
doltgres_scan_set_tidrange	void	TableScanDesc scan, ItemPointer mintid, ItemPointer maxtid	error	nocatalog	it writes the scan's own record, the range a later read takes	test/t/035_tidrange.pl: a range within the first block gives its rows in ctid order
doltgres_scan_getnextslot_tidrange	bool	TableScanDesc scan, ScanDirection direction, TupleTableSlot *slot	error	catalog	a tid range scan reads inside a transaction, as a seq scan does, and its keys' support functions may read any catalog	test/t/035_tidrange.pl: a range within the first block gives its rows in ctid order
doltgres_relation_size	uint64	Relation rel, ForkNumber forkNumber	error	catalog	it opens the storage's state through the backend's repository, which reads the repository's newest manifest, and a fork other than the main fork has no blocks	test/t/037_sizes.pl: a table of narrow rows reports the blocks its heap bytes fill
doltgres_relation_estimate_size	void	Relation rel, int32 *attr_widths, BlockNumber *pages, double *tuples, double *allvisfrac	error	catalog	it calls table_block_relation_estimate_size, which reads the relation's size and its pg_class row, and the average widths in pg_statistic	test/t/037_sizes.pl: the estimate gives heap's pages and tuples for the same rows
doltgres_parallelscan_estimate	Size	Relation rel	error	nocatalog	it answers the size of the fork's parallel scan, a constant of the build, and reads nothing	test/t/036_parallel.pl: scans sharing one pscan give the serial scan's rows, each once
doltgres_parallelscan_initialize	Size	Relation rel, ParallelTableScanDescData *pscan	error	catalog	table_block_parallelscan_initialize reads the relation's block count through its table access method's relation_size, and the base's fields come from the storage's held state	test/t/036_parallel.pl: scans sharing one pscan give the serial scan's rows, each once
doltgres_parallelscan_reinitialize	void	Relation rel, ParallelTableScanDescData *pscan	error	catalog	table_block_parallelscan_reinitialize stores zero in the shared count of blocks given out, and the split keys' read finds the storage's state, whose make reads the table's primary key from the catalog	test/t/036_parallel.pl: scans sharing one pscan give the serial scan's rows, each once
doltgres_scan_end	void	TableScanDesc scan	error	nocatalog	an end drops the scan's record and frees its descriptor	test/t/033_scan.pl: a seq scan of a table on the fork's storage gives its base's rows
doltgres_tuple_fetch_row_version	bool	Relation relation, ItemPointer tid, Snapshot snapshot, TupleTableSlot *slot	error	catalog	a fetch reads the relation's keyed layout from the catalog	test/t/033_scan.pl: a row fetched by its ctid is the row in that place of heap's order
doltgres_tuple_tid_valid	bool	TableScanDesc scan, ItemPointer tid	error	nocatalog	it reads the scan's own record	test/t/033_scan.pl: a ctid is valid only within the storage's blocks
doltgres_tuple_get_latest_tid	void	TableScanDesc scan, ItemPointer tid	error	catalog	it reads each version of the row's chain through the table's key layout, which the catalog gives, and the snapshot's check of each	test/t/046_update.pl: a moved row's latest tid is its new version's
doltgres_tuple_satisfies_snapshot	bool	Relation relation, TupleTableSlot *slot, Snapshot snapshot	error	catalog	a fetch reads the relation's keyed layout from the catalog	test/t/033_scan.pl: a fetched row satisfies the snapshot that reads it
doltgres_xact_ended	void	XactEvent event, void *arg	error	catalog	a transaction callback ends the fork's records at its commit or prepare and takes back its versions at its abort, reading no catalog there, and at its pre-commit, inside the transaction, it opens the relations of the storages it wrote for their keys' order	test/t/033_scan.pl: a scan's transaction commits with no record left to its resource owner
doltgres_tuple_insert	void	Relation rel, TupleTableSlot *slot, CommandId cid, uint32 options, struct BulkInsertStateData *bistate	error	catalog	an insert reads the table's key layout from its primary key and its toast target from its options, and a stored value's type output may read any catalog; it appends its row change to the WAL	test/t/038_insert.pl: a row inserted reads back with its ctid and xmin
doltgres_multi_insert	void	Relation rel, TupleTableSlot **slots, int nslots, CommandId cid, uint32 options, struct BulkInsertStateData *bistate	error	catalog	each row is inserted as doltgres_tuple_insert inserts one	test/t/038_insert.pl: a row inserted reads back with its ctid and xmin
doltgres_unlogged_cleanup	void		error	nocatalog	StartupXLOG runs it in recovery beside ResetUnloggedRelations, before any transaction, in the startup process or a standalone backend	test/t/039_runs.pl: after a crash an unlogged table's rows are gone, so its next insert takes the first ctid again
doltgres_subxact_ended	void	SubXactEvent event, SubTransactionId mySubid, SubTransactionId parentSubid, void *arg	error	nocatalog	a subtransaction callback marks, keeps, or takes back the keys its subtransaction wrote to, and reads no catalog	test/t/044_removal.pl: a rolled-back savepoint's rows are taken back and its parent's kept
doltgres_index_fetch_begin	struct IndexFetchTableData *	Relation rel, uint32 flags	error	nocatalog	a begin only allocates the fetch and records its relation and flags	test/t/033_scan.pl: an index fetch by a ctid gives the row a fetch of its version gives
doltgres_index_fetch_reset	void	struct IndexFetchTableData *fetch	error	nocatalog	a reset changes nothing, since a fetch keeps no place between rows	test/t/033_scan.pl: an index fetch by a ctid gives the row a fetch of its version gives
doltgres_index_fetch_end	void	struct IndexFetchTableData *fetch	error	nocatalog	an end only frees the fetch	test/t/033_scan.pl: an index fetch by a ctid gives the row a fetch of its version gives
doltgres_index_fetch_tuple	bool	struct IndexFetchTableData *fetch, ItemPointer tid, Snapshot snapshot, TupleTableSlot *slot, bool *call_again, bool *all_dead	error	catalog	a fetch reads the relation's keyed layout from the catalog	test/t/033_scan.pl: an index fetch by a ctid gives the row a fetch of its version gives
doltgres_relation_fetch_toast_slice	void	Relation toastrel, Oid valueid, int32 attrsize, int32 sliceoffset, int32 slicelength, varlena *result	error	catalog	a detoast runs inside a transaction, and the TOAST relation's storage state is found through its catalog entry	test/t/038_insert.pl: a toasted row inserted reads back whole
