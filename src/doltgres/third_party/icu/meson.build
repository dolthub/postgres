# ICU's table from a Windows locale id to its locale, which the C port's test of the fork's Windows sort names reads.
icu_locmap = files('common/locmap.cpp')

meson.override_dependency('icu-uc', declare_dependency(
  link_with: icuuc_lib,
  include_directories: include_directories('common'),
  compile_args: icu_user_args,
  version: meson.project_version(),
))
meson.override_dependency('icu-i18n', declare_dependency(
  link_with: [icui18n_lib, icuuc_lib],
  include_directories: include_directories('common', 'i18n'),
  compile_args: icu_user_args,
  version: meson.project_version(),
))
