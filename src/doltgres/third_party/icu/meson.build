# The pinned ICU4C (design item 12), compiled from the sources its own lists name (common/sources.txt and
# i18n/sources.txt) as two static libraries, which replace the system's ICU for Postgres: its collators give every
# platform the same sort keys. It is built without what no call Postgres makes can reach (formatting,
# transliteration, regular expressions, IDNA), and every name it defines carries ICU's version and the fork's suffix,
# through ICU's own switch, so a system ICU that another library brings into the process can't meet this one. Its
# symbols are hidden, so postgres exports none of them. Its data is no part of this build: the fork's own build compiles
# the filtered archive in (src/doltgres/icu), and ICU's stub of it is not vendored.

project('icu', 'cpp', version: '79.1', default_options: ['warning_level=0', 'cpp_std=c++17'])

cxx = meson.get_compiler('cpp')

# What ICU's users are compiled with as well as ICU: the static library's declarations, the names' suffix, and the
# parts built out.
icu_user_args = ['-DU_STATIC_IMPLEMENTATION', '-DU_HAVE_LIB_SUFFIX=1', '-DU_LIB_SUFFIX_C_NAME=_dg',
  '-DUCONFIG_NO_FORMATTING=1', '-DUCONFIG_NO_TRANSLITERATION=1', '-DUCONFIG_NO_REGULAR_EXPRESSIONS=1',
  '-DUCONFIG_NO_IDNA=1']
icu_args = icu_user_args + ['-DU_ENABLE_DYLOAD=0', '-DU_ATTRIBUTE_DEPRECATED=', '-DUNISTR_FROM_CHAR_EXPLICIT=explicit',
  '-DUNISTR_FROM_STRING_EXPLICIT=explicit']
# ICU's sources are UTF-8. Its cmemory.h uses std::forward_as_tuple with no include of <tuple>, which MSVC's library
# no longer brings in through <memory>, so MSVC includes it first in every file, the pinned source staying as it is.
if cxx.get_argument_syntax() == 'msvc'
  icu_args += ['-utf-8', '-D_CRT_SECURE_NO_DEPRECATE', '-FItuple']
endif
# Each floating-point operation rounds on its own, as in every build of the fork (design item 15); a subproject
# doesn't get the flag from Postgres' own.
if cxx.get_id() in ['gcc', 'clang']
  icu_args += '-ffp-contract=off'
endif

